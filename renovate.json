{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One PR per ecosystem for non-breaking updates; majors stay separate.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "{{manager}} non-major updates"
    },
    {
      "description": "engines.vscode is the oldest supported VS Code, and @types/vscode may not be newer than it.",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@types/vscode"],
      "enabled": false
    },
    {
      "description": "A comparator-matrix pin is the version its data file records; moving it means regenerating the file.",
      "matchFileNames": ["tools/phpunit-comparator-matrix/**"],
      "enabled": false
    },
    {
      "description": "Each line of php-images.lock is one PHP version, so only its digest moves.",
      "matchFileNames": ["crates/phpstan-rs/tests/runtime_oracle/php-images.lock"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "mold, installed by rui314/setup-mold.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/(workflows|actions)/.+\\.ya?ml$/"],
      "matchStrings": ["mold-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "rui314/mold",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "Cargo tools installed by taiki-e/install-action.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>cargo-[a-z-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "crate"
    },
    {
      "description": "PHP images pinned by digest, for the runtime oracle and the comparison matrix.",
      "customType": "regex",
      "managerFilePatterns": ["/^crates/phpstan-rs/tests/runtime_oracle/php-images\\.lock$/"],
      "matchStrings": ["(?<depName>php):(?<currentValue>\\d+\\.\\d+-cli)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    }
  ]
}
