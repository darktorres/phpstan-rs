# libFuzzer dictionary for lex_and_parse (`-dict=fuzz/php.dict`).
#
# Every entry is a real token this project's own lexer/parser recognizes -
# built directly from src/token.rs's `Keyword` table (as_str() spellings)
# and the punctuation/operator tokens the lexer itself matches
# (src/lexer.rs), not guessed. Biases libFuzzer's mutator toward inserting
# whole tokens instead of random bytes, which mostly just hit the lexer's
# own "unexpected byte, skipping" fallback (src/lexer.rs:855).

# --- structural, not a single Token variant ---
"<?php"
"<?="
"?>"
"$this"
"#[Attribute]"
"/** @param int $x */"

# --- Keyword (src/token.rs Keyword::as_str) ---
"function"
"class"
"interface"
"trait"
"enum"
"extends"
"implements"
"public"
"private"
"protected"
"static"
"const"
"final"
"abstract"
"readonly"
"if"
"elseif"
"else"
"while"
"do"
"for"
"foreach"
"as"
"switch"
"case"
"default"
"break"
"continue"
"return"
"echo"
"print"
"new"
"clone"
"instanceof"
"true"
"false"
"null"
"namespace"
"use"
"global"
"try"
"catch"
"finally"
"throw"
"array"
"and"
"or"
"xor"
"include"
"include_once"
"require"
"require_once"
"yield"
"list"
"fn"
"match"
"endif"
"endwhile"
"endfor"
"endforeach"
"endswitch"
"goto"

# --- multi-character punctuation/operator tokens (src/lexer.rs) ---
"::"
"->"
"?->"
"=>"
"??"
"??="
"."
".="
"++"
"--"
"**"
"**="
"+="
"-="
"*="
"/="
"%="
"&="
"|="
"^="
"<<"
"<<="
">>"
">>="
"=="
"==="
"!="
"!=="
"<>"
"<="
">="
"<=>"
"&&"
"||"
"..."
"|>"
"#["
"${"
