index 000000000..098cc4a6f
--- /dev/null
+++ b/crates/phpstan-rs/src/mark.rs
@@ -0,0 +1,47 @@
+//! Measurement only (see scripts/measure/marks.patch): at each mark, the
+//! process's CPU time (including exited threads), the runnable-wait time
+//! summed over its tasks, and the machine's jiffies from /proc/stat, printed
+//! as one SNAP line.
+
+use std::fs;
+
+#[allow(unsafe_code)]
+pub fn mark(label: &str) {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+    // SAFETY: both calls write into the structs they are given.
+    unsafe {
+        libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts);
+        libc::getrusage(libc::RUSAGE_SELF, &mut usage);
+    }
+    let now = ts.tv_sec as i128 * 1_000_000_000 + ts.tv_nsec as i128;
+    let cpu = |tv: libc::timeval| tv.tv_sec as i128 * 1_000_000_000 + tv.tv_usec as i128 * 1_000;
+    let process_cpu = cpu(usage.ru_utime) + cpu(usage.ru_stime);
+
+    let mut waited: u128 = 0;
+    if let Ok(entries) = fs::read_dir("/proc/self/task") {
+        for entry in entries.flatten() {
+            let Ok(text) = fs::read_to_string(entry.path().join("schedstat")) else {
+                continue;
+            };
+            if let Some(v) = text.split_whitespace().nth(1).and_then(|v| v.parse::<u128>().ok()) {
+                waited += v;
+            }
+        }
+    }
+
+    let stat = fs::read_to_string("/proc/stat").unwrap_or_default();
+    let jiffies: Vec<String> = stat
+        .lines()
+        .next()
+        .unwrap_or("")
+        .split_whitespace()
+        .skip(1)
+        .map(str::to_owned)
+        .collect();
+    eprintln!(
+        "SNAP {label} {now} {process_cpu} {waited} {} {:?}",
+        jiffies.join(" "),
+        std::thread::current().id()
+    );
+}
