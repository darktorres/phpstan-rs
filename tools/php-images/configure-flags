# The configure options the build passes, each where the version's
# configure offers it: every bundled extension and SAPI, and each option
# that adds an extension's functions. Options a version lacks are left out;
# `excluded.tsv` drops the ones that cannot build there.

# The official image's build.
--with-pic

# SAPIs. Not embed: it defines no function, and configure builds one SAPI
# module only, apache2handler here.
--enable-cli
--enable-cgi
--enable-fpm
--with-fpm-acl
--with-fpm-apparmor
--with-fpm-selinux
--with-fpm-systemd
--enable-litespeed
--enable-phpdbg
--enable-phpdbg-readline
--with-apxs2=/usr/bin/apxs

